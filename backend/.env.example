# --- Django -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
# Comma-separated. Leave blank to allow all hosts (fine for local dev).
DJANGO_ALLOWED_HOSTS=
# Comma-separated origins that may call the API. Blank = allow all (dev only).
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Storage ------------------------------------------------------------
# Blank = SQLite in backend/db.sqlite3. Example: postgres://user:pass@host:5432/db
DATABASE_URL=
# Optional: redis://localhost:6379/1 for a shared cache (routing/geocoding results)
REDIS_URL=

# --- External services (all free, no key needed by default) --------------
# osrm (default, keyless) or ors (OpenRouteService, needs ORS_API_KEY, truck profile)
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ORS_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io
# Nominatim's usage policy requires an identifying User-Agent with contact info.
GEOCODER_USER_AGENT=eld-trip-planner/1.0 (you@example.com)

# --- Planner tuning -----------------------------------------------------
MAX_AVERAGE_SPEED_MPH=60
LOG_LEVEL=INFO
